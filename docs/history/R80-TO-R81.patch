+        }
+        boot_id_exists(){ case " $MOCK_PRIMARY $MOCK_FALLBACK 0000 0007 " in *" $1 "*) return 0;; *) return 1;; esac; }
+        leap16_current_boot_order(){ printf '%s\n' "$MOCK_ORDER"; }
