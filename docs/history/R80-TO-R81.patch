+        }
+        ok(){ :; }; fail(){ :; }
+        if [[ $scenario == once ]]; then
+            leap16_r80_normalize_limine_aliases_after_fallback_proof || fail_test 'one alias re-synthesis wave did not converge'
+            [[ $deletes == 2 && $MOCK_PRIMARY == 0002 && $MOCK_ORDER == 0002,0004,0000,0007 ]] \
